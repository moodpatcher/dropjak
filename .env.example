# Dropjak — Docker environment
#
# Usage:
#   cp .env.example .env
#   edit the .env file
#   docker compose up -d --build
#
# docker compose reads the .env file automatically. Missing required
# values prevent the container from starting (fail-closed).

# WARNING — you can lock yourself out of the host:
# Loading the firewall drops the current SSH connection if there is no active,
# permitted portal session from that source IP and no host rule explicitly
# allowing TCP port 22. Set up the admin account below BEFORE the first
# `docker compose up`; without an admin account you cannot log in to the
# portal, and host SSH stays closed. Keep the provider console open so you
# can restore access if you are locked out.

# The name of the internal (LAN) interface on the VM. Check: ip -br link
# For a bridge/VLAN, provide the name of the interface carrying the gateway's LAN IP.
HV_LAN_IF=eth1

# The name of the external (WAN) interface on the VM.
HV_WAN_IF=eth0

# The internal network in IPv4 CIDR form. Clients come from this range.
HV_LAN_NET=192.168.10.0/24

# The portal source network. The portal is always reachable from the LAN
# interface; this setting controls access from the WAN/internet.
# For a public portal (reachable from the internet): 0.0.0.0/0.
# If left empty, the value of HV_MGMT_NET is used.
# WARNING: this puts the portal on the internet; host SSH still only
# works with an active, permitted portal session, and only if the host
# rule assigned to the user explicitly lists TCP port 22. UDP 22 is an
# ordinary host port, not SSH.
# HV_PORTAL_NET=0.0.0.0/0

# Backward-compatible base value for HV_PORTAL_NET. It no longer allows
# SSH: host SSH is opened by an active session obtained through the portal,
# if the host rule assigned to the user explicitly lists TCP port 22.
# For a public portal, use HV_PORTAL_NET=0.0.0.0/0.
HV_MGMT_NET=192.168.10.0/24

# The portal port on the host. nft redirects port 80 here.
PORT=8100

# Optional: canonical portal address, if you point the browser here.
# HV_PORTAL_URL=http://192.168.10.1:8100

# Optional: portal-protected subdomain proxy (Caddy, automatic HTTPS).
# HV_PROXY=1 opens TCP 80/443 (after the fail2ban, block and MAC drops;
# from the LAN only with a fixed IP+MAC pair), and
# COMPOSE_PROFILES=proxy starts the caddy service. Paths must be set under
# Admin → Settings → Proxy (e.g. owui → 3000).
# DNS ("DNS only", without CDN proxy, so Caddy sees the real client IP):
#   A z1.example.com    → the host's public IPv4 address
#   A *.z1.example.com  → the same
# There must be no AAAA record: incoming IPv6 traffic is dropped by the firewall.
# HV_PROXY=1
# COMPOSE_PROFILES=proxy

# Startup admin account. If 1, the container creates the given user with the
# admin role on every start, or updates it to the given password. The admin
# manages users, groups, rules and logs in the portal's Admin panel.
# The .env file must be 0600 because the password is stored in it in plain text.
# WARNING: without an admin account, after the first start the portal's Admin panel
# is unreachable and host SSH stays closed. Set these values BEFORE the first
# `docker compose up`, and keep the provider console open. The admin account
# alone does not open SSH: create a host (input) rule on the portal that
# explicitly allows TCP 22, and assign it to the admin (or a group), otherwise
# host SSH stays closed after the first firewall load. If needed, start with
# HV_SKIP_FIREWALL=1.
# Generate a password: openssl rand -hex 16
# 0 does not delete a previously created account, it just ignores it.
HV_ADMIN_ENABLED=0
# HV_ADMIN_USER=admin
# HV_ADMIN_PASSWORD=change-me
# Even safer: provide a read-only file (e.g. a Docker secret).
# HV_ADMIN_PASSWORD_FILE=/run/secrets/dropjak_admin

# The service catalog and the scenario descriptions that provide the initial
# rules. The file is copied into the container by the Dockerfile; rebuild after changes.
# Scenarios are only created as rules when rules.json does not yet exist.
# Later rule management happens in the admin interface.
# HV_SERVICES_FILE=/opt/hatarvedelem/services.json

# State files. By default they are under HV_STATE_DIR; in compose this is
# the hatarvedelem-state volume. Specify a separate path only when justified.
# HV_RULES=/var/lib/hatarvedelem/rules.json
# HV_GROUPS=/var/lib/hatarvedelem/groups.json
# HV_AUDIT_LOG=/var/lib/hatarvedelem/audit.jsonl

# Audit log rotation: rotates at this size (bytes), and keeps this many old
# files. The log is created with 0600 permissions and contains no passwords.
# HV_AUDIT_MAX_BYTES=10485760
# HV_AUDIT_KEEP=5

# Default access duration in seconds. After logging in, the user can choose
# up to the maximum associated with the rule; this is only the initial value.
# The nft set elements themselves also expire in the kernel after this time,
# even if the portal stops.
HV_SESSION_TTL=3600

# Global narrowing of the selectable durations (seconds). The rule's own
# max_ttl value further restricts it. The hard limit is 60–2592000 (30 days).
# HV_MIN_TTL=60
# HV_MAX_TTL=2592000

# Drop log: logging of packets dropped by nftables via NFLOG. The portal
# listens on the group over a raw netlink socket, and writes the packet
# headers (not the full contents) to a JSONL file. The log is in the state volume.
# With HV_DROP_LOG=0 the portal does not listen on the group; nft rule
# logging remains, but the interface does not show new entries.
# The group can be 1–65535, and must not collide with another NFLOG consumer.
# HV_DROP_LOG=1
# HV_DROP_LOG_GROUP=5
# HV_DROP_LOG_PATH=/var/lib/hatarvedelem/drops.jsonl
# HV_DROP_LOG_MAX_BYTES=10485760
# HV_DROP_LOG_KEEP=5

# The file for the pre-auth/block rules configured in the interface.
# HV_SETTINGS=/var/lib/hatarvedelem/firewall-settings.json

# Fail2ban: counts failed password logins by source IP.
# If an IP reaches the threshold within the given time window, the firewall
# puts it in the banned_v4 set and drops its packets (except for the portal
# and DHCP). The ban lasts for the given time, then the kernel expires it.
# The above values can also be changed at runtime on the portal's Admin -> Fail2ban
# page; the value here is only the initial default for the first start.
# HV_FAIL2BAN=1            # 0: disable login monitoring only
# HV_FAIL2BAN_MAX=5        # failed logins until the ban (1–100)
# HV_FAIL2BAN_WINDOW=600   # time window in seconds (30–86400)
# HV_FAIL2BAN_BAN=3600     # ban length in seconds (60–2592000)
# HV_FAIL2BAN_STATE=/var/lib/hatarvedelem/fail2ban.json
#
# Drop-based banning: source IPs that cause many dropped TCP packets
# without logging in (port scanners, bots) are also banned.
# The ban starts when the IP reaches the packet-count threshold within the window,
# OR tries to reach this many different destination ports. DNS and the portal port
# do not count. Can be set at runtime on the Admin -> Fail2ban page.
# The two metrics can be toggled separately, independently of each other and of
# login monitoring. The threshold is at least 1; there is no 0 = disabled mode.
# HV_FAIL2BAN_DROP=1       # gates both metrics at first start
# HV_FAIL2BAN_DROP_COUNT_ENABLED=1   # default for the packet-count metric
# HV_FAIL2BAN_DROP_PORTS_ENABLED=1   # default for the port-diversity metric
# HV_FAIL2BAN_DROP_MAX=120       # dropped packets until the ban (1–10000)
# HV_FAIL2BAN_DROP_PORTS=12      # different destination ports until the ban (1–4096)
# HV_FAIL2BAN_DROP_WINDOW=180    # time window in seconds (30–86400)
#
# Proxy-based banning: if an IP receives this many unauthorized (401) responses
# from the domain proxy (Caddy) within the window, it is placed in the
# proxy_banned_v4 set. This only closes the host's TCP 80/443; the portal's own
# port remains reachable. The ban length is HV_FAIL2BAN_BAN.
# HV_FAIL2BAN_PROXY=1            # default for the proxy metric
# HV_FAIL2BAN_PROXY_MAX=20       # unauthorized requests until the ban (1–10000)
# HV_FAIL2BAN_PROXY_WINDOW=600   # time window in seconds (30–86400)

# How long password login remains valid before rule selection
# (seconds). If no /api/access request is sent within this time, the session
# becomes invalid and no network access is granted.
# HV_AUTH_TTL=600

# The issuer/label of the TOTP 2FA otpauth:// URI (the name shown in the
# authenticator app), if no firewall name is set in the portal
# (Admin → Settings → Firewall name). Default: Dropjak.
# HV_TOTP_ISSUER=Dropjak

# Proof-of-work difficulty (1–6 leading hex zeros).
HV_POW_DIFFICULTY=4

# Optional fine-tuning (compose forwards it to the container):
# HV_CHALLENGE_TTL=600
# HV_PBKDF2_ITERATIONS=600000
# HV_RATE_WINDOW=60
# HV_RATE_MAX=10
# HV_FLUSH_ON_START=1       # 1: logs everyone out when the portal starts
# HV_ALLOW_STALE_GRANTS_ON_START=0
#                           # 1: NOT safe; kernel grants from before the restart
#                           # can remain in effect without a session until the TTL
#                           # (up to 30 days)
# HV_FIREWALL_WATCHDOG=1    # 0: disable the firewall watchdog
# HV_COOKIE_SECURE=0        # 1: Secure cookie behind HTTPS termination

# Development / debugging only:
# HV_DRY_RUN=1            # the portal does not modify the nft set
# HV_SKIP_FIREWALL=1      # loading the rules is skipped (NOT safe)
# HV_RUN_AS_ROOT=1        # the portal runs as root instead of setpriv

# Optional Cloudflare Turnstile. On a blocked network ahead of the zone,
# Turnstile is usually unusable, so the default captcha is a locally
# verified proof-of-work.
# TURNSTILE_SITEKEY=
# TURNSTILE_SECRET=
