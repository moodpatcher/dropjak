#!/usr/sbin/nft -f
#
# Dropjak — nftables rules
#
# This file is generated by install.sh by substituting the placeholders.
# After manual editing: nft -c -f /etc/nftables/dropjak.nft
#
# The file is IDEMPOTENT: loading it repeatedly does not duplicate the rules,
# and the elements of the allowed_v4 set are preserved. This is also used by
# the ExecReload of dropjak-firewall.service.
#
# Principles:
#   - forward: everything is denied; a logged-in client can only reach the
#     TCP/UDP destination ports of the chosen rule (allowed_tcp/allowed_udp),
#     and ICMP through allowed_icmp; with full access, as a member of the
#     allowed_v4 set
#   - input:   the portal is reachable by everyone; host SSH (TCP 22)
#     is opened exclusively through a host (input) rule created by an admin
#     and assigned to the user (allowed_input_tcp, explicit 22), with an
#     active, authorized portal session; DNS/DHCP from the LAN
#   - the HTTP of unauthorized clients is redirected to the login page
#
# iifname/oifname is used so that loading the rules does not depend on
# when the given interface (VLAN, bridge, bond) is created during boot.
# If the interface does not exist, the rule does not match, so the
# traffic stays denied (fail-closed).

# Creation of the table, the set and the chains. If they already exist,
# these commands do not change them.
add table inet hatarvedelem

# The IPv4 addresses of clients choosing full access go here,
# with a kernel-side expiry.
add set inet hatarvedelem allowed_v4 {
    type ipv4_addr
    flags timeout
    size 4096
}

# Port-restricted access: client IP + destination port pairs.
# The ports come from the rule chosen by the client (rules.json).
# The interval flag is needed for the "8000-8100" range elements; with timeout
# there is no auto-merge, so overlaps are handled by gateway.py.
add set inet hatarvedelem allowed_tcp {
    type ipv4_addr . inet_service
    flags interval,timeout
    size 16384
}

add set inet hatarvedelem allowed_udp {
    type ipv4_addr . inet_service
    flags interval,timeout
    size 16384
}

# Host (input) rules: the portal machine's own services, which we open
# to the logged-in client's IP until the session TTL. We store them
# separately from the forward sets, and only the incoming (input) chain
# accepts traffic from them. Only the portal port (PORT) is reserved: the
# portal's validation does not allow adding it here, and the accept rule
# below also excludes it. Port 22 can be declared by a host rule created by
# an administrator; host acceptance excludes the portal port regardless.
add set inet hatarvedelem allowed_input_tcp {
    type ipv4_addr . inet_service
    flags interval,timeout
    size 16384
}

add set inet hatarvedelem allowed_input_udp {
    type ipv4_addr . inet_service
    flags interval,timeout
    size 16384
}

# Destination ports ever declared in host (input) rules. Normal
# syncing only adds to these: thus deleting a rule cannot reopen an
# already existing connection. The input chain uses these to cut off
# established traffic when the permission disappears, even if flushing
# conntrack fails, or the kernel (nf_conntrack_tcp_loose) revives
# the flow. Stale ports are harmless: they only make the
# established traffic check stricter.
#
# The size is 65536: the number of valid host ports is at most 65535, so the
# set can never fill up, and no guard element can silently be lost. The
# pruning deletes only single-port elements that no persisted
# rule references and to which no live conntrack entry belongs. Range
# elements remain untouched, because partial deletion would remove the
# entire element. On startup the set is deliberately not
# cleared: old flows of deleted ports thus remain cut off.
add set inet hatarvedelem host_service_tcp {
    type inet_service
    flags interval
    size 65536
}

add set inet hatarvedelem host_service_udp {
    type inet_service
    flags interval
    size 65536
}

# ICMP (ping) permission for the client IP.
add set inet hatarvedelem allowed_icmp {
    type ipv4_addr
    flags timeout
    size 4096
}

# MAC address bound to the client. The source IP alone can be spoofed on the LAN
# (by taking another client's allowed IP), so for the allowed IP the portal
# also records the MAC address from the client's ARP entry.
# The related drop rules are only valid on the LAN interface.
add set inet hatarvedelem client_mac {
    type ipv4_addr . ether_addr
    flags timeout
    size 4096
}

# fail2ban: source IPs committing too many failed logins. The element
# expires after the configured ban time; after a successful ban the portal
# puts the IP here, and deletes it immediately on unban. Packets from a banned source
# are dropped in both the forward and the input chain (except the portal and DHCP).
add set inet hatarvedelem banned_v4 {
    type ipv4_addr
    flags timeout
    size 4096
}

# fail2ban proxy ban: source IPs receiving too many unauthorized (401) requests
# on the domain proxy. It only closes the host's TCP 80/443 (all of Caddy's,
# including the HTTPS portal); the portal's own port and every other access remain.
add set inet hatarvedelem proxy_banned_v4 {
    type ipv4_addr
    flags timeout
    size 4096
}

# Destinations the gateway never forwards to, whatever grant or pre-auth
# entry a client has (DJ-02). 169.254.0.0/16 is link-local: on cloud VMs the
# provider's metadata service (169.254.169.254) lives there, and masquerade
# would present the client's request as the VM's own. The elements below are
# re-added on every load; extra provider networks can be added the same way.
add set inet hatarvedelem no_forward_v4 {
    type ipv4_addr
    flags interval
}
add element inet hatarvedelem no_forward_v4 { 169.254.0.0/16 }
# Container bridges whose name does not match docker*/br-* (a Docker network
# with a custom com.docker.network.bridge.name, other bridges on the host).
# The Docker entrypoint fills it from `ip -o link show type bridge` (without
# the LAN and WAN interfaces) at startup and the watchdog keeps it current;
# loading the template does not clear it. Empty on a native install.
add set inet hatarvedelem docker_bridges {
    type ifname
}

# The forward chain is created further below, in the same transaction as the
# rules, with priority -10. Thus it runs BEFORE the Docker ip filter FORWARD
# chain, and the Docker DOCKER-USER chain only passes packets marked by it.
# The bare add chain is idempotent: it does not modify an existing chain.
add chain inet hatarvedelem forward

# Emergency (break-glass) chain. Loading the template does NOT clear it, so a
# temporarily added SSH permission survives reloading the rules and
# restarting the portal. It is empty by default; it has no effect on normal traffic.
# Usage (delete it immediately after use):
#   nft add rule inet hatarvedelem breakglass \
#       ip saddr 203.0.113.10 tcp dport 22 accept
#   nft delete rule inet hatarvedelem breakglass handle <handle>
add chain inet hatarvedelem breakglass

# Chains customized by the admin. The portal fills them on startup and
# on configuration changes; loading the template does not clear them, so a
# reload neither opens nor closes the configured targets.
#   preauth:    forward targets/ports reachable before login too
#   preauth_input: host (input) ports reachable before login
#   block:      always-dropped LAN traffic (before pre-auth)
#   preauth_nat: pre-auth TCP 80 bypasses the portal redirect
#   block_nat:  drops blocked TCP 80 before the redirect
add chain inet hatarvedelem preauth
add chain inet hatarvedelem preauth_input
add chain inet hatarvedelem block
add chain inet hatarvedelem preauth_nat
add chain inet hatarvedelem block_nat

# Port proxy (DNAT entries configured on the portal's Proxy tab). The portal
# fills them on startup and on changes; the template does not clear them.
#   portproxy_nat:   DNAT (forward) / redirect (input) to the listening port
#   portproxy_input: permission for the redirected traffic (allowed_input_*)
#   portproxy_snat:  requested masquerade for the forward entry
add chain inet hatarvedelem portproxy_nat
add chain inet hatarvedelem portproxy_input
add chain inet hatarvedelem portproxy_snat

# WireGuard tunnel receive chain (3.20). The portal fills it; it remains empty
# without an enabled agent, so the WireGuard UDP port is closed. The
# template does not clear it, so a reload does not close the existing tunnel.
add chain inet hatarvedelem tunnel_input

add chain inet hatarvedelem input {
    type filter hook input priority filter; policy drop;
}

add chain inet hatarvedelem prerouting {
    type nat hook prerouting priority dstnat; policy accept;
}

# The port proxy DNAT runs in its own chain with priority -101 (dstnat - 1).
# For a new connection the kernel calls the nat chains by priority, and after
# the first NAT binding it no longer runs the rest (Docker's -100 ip nat PREROUTING
# and the prerouting chain above). Thus a Proxy entry on the
# configured interfaces deterministically precedes Docker's publication of the
# same port; at equal priority the order would depend on registration.
add chain inet hatarvedelem portproxy_prerouting {
    type nat hook prerouting priority -101; policy accept;
}

add chain inet hatarvedelem postrouting {
    type nat hook postrouting priority srcnat; policy accept;
}

# Loopback and IPv6 guard before NAT and conntrack (raw priority), when the address is still
# the original address as it arrived on the wire. The input port proxy DNATs to
# 127.0.0.1 for a target that only listens on 127.0.0.1, which requires
# net.ipv4.conf.all.route_localnet=1 on the host; with that, the kernel would
# not drop packets with a 127/8 destination (and source) arriving from outside
# as martians either. This chain drops them on every non-loopback interface, so
# the loopback services are reachable only through the proxy (authorized DNAT).
# It is harmless without route_localnet too: these packets are martians anyway.
# It also drops every IPv6 packet that did not arrive on loopback.
add chain inet hatarvedelem loopback_guard {
    type filter hook prerouting priority raw; policy accept;
}

# Replacing the chains' rules. The flush and the new rules run in the same
# nft transaction, so there is no open time window. We do not touch the set:
# the reload does not log the clients out.
#
# The forward chain is recreated so that its priority is -10 even on an old
# installation. The deletion and recreation happen in the same transaction,
# so there is no moment without a forward chain.
flush chain inet hatarvedelem forward
delete chain inet hatarvedelem forward
add chain inet hatarvedelem forward {
    type filter hook forward priority -10; policy drop;
}
flush chain inet hatarvedelem input
flush chain inet hatarvedelem prerouting
flush chain inet hatarvedelem portproxy_prerouting
flush chain inet hatarvedelem postrouting
flush chain inet hatarvedelem loopback_guard

table inet hatarvedelem {
    chain forward {
        # We do not forward IPv6. The ip_forward sysctl only applies to IPv4;
        # this rule closes even if IPv6 forwarding were enabled for some reason.
        meta nfproto ipv6 limit rate 10/minute burst 20 packets log prefix "dropjak-drop reason=ipv6 " group __DROP_LOG_GROUP__
        meta nfproto ipv6 drop

        # Source-IP spoofing prevention. On the LAN interface only sources belonging
        # to the LAN network may come in; from the WAN it is forbidden to take
        # the LAN address. This rules out a client using the forward rules with
        # another allowed client's IP (or with a LAN source from the WAN).
        iifname "__LAN_IF__" ip saddr != __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-lan " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr != __LAN_NET__ drop
        iifname "__WAN_IF__" ip saddr __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-wan " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" ip saddr __LAN_NET__ drop
        # A LAN source is only valid on the LAN interface. Without this, a
        # process on any other interface (a Docker bridge, an extra NIC or VLAN)
        # could use a LAN client's grants with that client's address.
        iifname != "__LAN_IF__" ip saddr __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-lan " group __DROP_LOG_GROUP__
        iifname != "__LAN_IF__" ip saddr __LAN_NET__ drop

        # fail2ban-banned source: logged dropping of forwarded traffic.
        # This rule runs before the permitting sets and the pre-auth chain,
        # so a previously opened or pre-auth access does not apply during the
        # ban either. Logging is sampled (the limit only restricts the log);
        # the portal assigns these hits to the ban's single event, so the
        # interface does not get a per-packet line. When the ban expires, the
        # kernel deletes the element by itself. Only the original direction
        # is dropped: replies to connections that a LAN client opened toward
        # a banned address still pass, so banning a remote host does not
        # cut it off for every client.
        ip saddr @banned_v4 ct direction original limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=fail2ban " group __DROP_LOG_GROUP__
        ip saddr @banned_v4 ct direction original drop

        # MAC binding: anyone using an allowed IP must send with the MAC address
        # recorded during the session. This protects against an IP moving to another
        # machine after DHCP expiry and against IP spoofing within the LAN.
        # The portal records the MAC from the ARP table.
        # For port rules we only check the original direction (the client's packets):
        # the response of a LAN-side DNAT target (port proxy forward) also arrives
        # on the LAN interface, with the target's own IP/MAC pair, which
        # never appears in the client_mac set.
        iifname "__LAN_IF__" ip saddr @allowed_v4 ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr @allowed_v4 ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" meta l4proto tcp ct direction original ct original ip saddr . ct original proto-dst @allowed_tcp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" meta l4proto tcp ct direction original ct original ip saddr . ct original proto-dst @allowed_tcp ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" meta l4proto udp ct direction original ct original ip saddr . ct original proto-dst @allowed_udp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" meta l4proto udp ct direction original ct original ip saddr . ct original proto-dst @allowed_udp ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" ip saddr @allowed_icmp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr @allowed_icmp ip saddr . ether saddr != @client_mac drop

        # Block configured by the admin. We call it unconditionally: the block chain
        # matches the conntrack original tuple, so it also covers the response
        # direction, and packets arriving from the LAN, the WAN/DNAT and the Docker
        # bridge also reach it. With a LAN-restricted jump, the server side could
        # still send within an existing flow after the block, and WAN/DNAT traffic
        # would never reach the block chain. The block runs before every permission
        # (session, pre-auth, container), so an active session cannot bypass it
        # either; no conntrack flush is needed, because every packet reaches it.
        jump block

        # Destinations that no grant may reach (link-local / cloud metadata,
        # see the no_forward_v4 set). It runs before every accept, so neither a
        # full-access session, a port grant, a pre-auth entry nor the container
        # exception can reach them.
        ip daddr @no_forward_v4 limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=no-forward " group __DROP_LOG_GROUP__
        ip daddr @no_forward_v4 drop

        # Grants are not scoped by destination, so without these rules a grant
        # would also reach every container IP on the Docker bridges and, from
        # the WAN side, the LAN. A new flow may enter a Docker bridge or the LAN
        # from the WAN only if it was DNAT-ed (a published port or a port
        # proxy entry). Only the original direction is checked: the replies of
        # flows the container or the LAN host started are not affected.
        # Bridges with other names are covered by the docker_bridges set.
        oifname "docker*" ct direction original ct status != dnat limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=container-direct " group __DROP_LOG_GROUP__
        oifname "docker*" ct direction original ct status != dnat drop
        oifname "br-*" ct direction original ct status != dnat limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=container-direct " group __DROP_LOG_GROUP__
        oifname "br-*" ct direction original ct status != dnat drop
        oifname @docker_bridges ct direction original ct status != dnat limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=container-direct " group __DROP_LOG_GROUP__
        oifname @docker_bridges ct direction original ct status != dnat drop
        iifname "__WAN_IF__" oifname "__LAN_IF__" ct direction original ct status != dnat limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=wan-drop " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" oifname "__LAN_IF__" ct direction original ct status != dnat drop

        # Port-restricted access. The ct original proto-dst means the destination port
        # BEFORE DNAT, so for container ports published by Docker the
        # host port must appear in the rule. The same pair also matches in the
        # response direction (the conntrack original tuple belongs to the client
        # traffic), so no separate response rule is needed. If the element expires,
        # the responses stall too; deleting conntrack enforces this immediately on
        # existing connections as well.
        # The meta l4proto prefix is mandatory: without it the size of ct original
        # proto-dst is unknown in the concat expression (nft 1.0.6).
        #
        # Every permitting rule marks the packet. In Docker's DOCKER-USER chain we
        # only pass this mark; so if this table disappeared for any reason, Docker's
        # own FORWARD rules (for example the published container ports) would not open
        # a path either, because there is no mark.
        meta l4proto tcp ct original ip saddr . ct original proto-dst @allowed_tcp meta mark set __FWD_MARK__ accept
        meta l4proto udp ct original ip saddr . ct original proto-dst @allowed_udp meta mark set __FWD_MARK__ accept
        ip saddr @allowed_icmp ip protocol icmp meta mark set __FWD_MARK__ accept

        # Full access.
        ip saddr @allowed_v4 meta mark set __FWD_MARK__ accept

        # The response direction of full access and ICMP. The responses of the port
        # rules are covered by the ct original rules above.
        ct state established,related ip daddr @allowed_icmp ip protocol icmp meta mark set __FWD_MARK__ accept
        ct state established,related ip daddr @allowed_v4 meta mark set __FWD_MARK__ accept

        # It must not be possible to send packets from the WAN with the container's
        # source: the container's outbound permissions are only valid from the Docker bridge.
        iifname "__WAN_IF__" ip saddr 172.30.0.2 limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=container-spoof " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" ip saddr 172.30.0.2 drop

        # The container must not be able to initiate new connections to the internal
        # LAN. The responses of client -> container connections are in the established
        # state, so this rule does not affect them.
        ip saddr 172.30.0.2 ip daddr __LAN_NET__ ct state new limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=container-pivot " group __DROP_LOG_GROUP__
        ip saddr 172.30.0.2 ip daddr __LAN_NET__ ct state new drop

        # The Minecraft container's outbound traffic. The container runs on its own
        # dedicated Docker network (172.30.0.0/24, static address 172.30.0.2),
        # and needs DNS, HTTP and HTTPS for Mojang download/login.
        # The responses arrive in the established/related state.
        # This does not open client traffic: from the LAN only the ports allowed by
        # the portal rule still pass.
        ip saddr 172.30.0.2 udp dport 53 meta mark set __FWD_MARK__ accept
        ip saddr 172.30.0.2 tcp dport { 53, 80, 443 } meta mark set __FWD_MARK__ accept
        # Responses of connections INITIATED BY the container only. The earlier rule
        # passed all established traffic belonging to the container, so the
        # client->container connection stayed alive even after the port permission
        # expired (without deleting conntrack).
        ip daddr 172.30.0.2 ct state established,related ct original ip saddr 172.30.0.2 meta mark set __FWD_MARK__ accept

        # Pre-login permissions. The pre-auth chain also covers the response
        # direction, so we call it unconditionally.
        jump preauth

        # Logged dropping of the remaining, unauthorized traffic.
        # The limit only restricts logging; the drop applies to every packet.
        iifname "__LAN_IF__" limit rate 60/minute burst 120 packets log prefix "dropjak-drop reason=no-grant " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=wan-drop " group __DROP_LOG_GROUP__
        drop
    }

    chain input {
        iif lo accept

        # IPv6 is always dropped: the portal, SSH and every grant are
        # IPv4-only, and nothing may open IPv6 (the breakglass chain below
        # included). Only loopback (::1 on lo) passes above; it cannot come
        # from the network.
        meta nfproto ipv6 limit rate 10/minute burst 20 packets log prefix "dropjak-drop reason=ipv6 " group __DROP_LOG_GROUP__
        meta nfproto ipv6 drop

        # Emergency chain right after the IPv6 drop: the temporary accept in it
        # survives reloading the template. Empty by default.
        jump breakglass

        # The DHCP request arrives with a 0.0.0.0 source before address assignment, so
        # we let it through before the source check. Only from the standard
        # client port (68) to the server port (67), and only with a 0.0.0.0 source.
        iifname "__LAN_IF__" ip saddr 0.0.0.0 udp sport 68 udp dport 67 accept

        # Source-IP spoofing prevention toward the host as well. From the WAN it is
        # forbidden to take the LAN address; from the LAN only the LAN network may come.
        iifname "__LAN_IF__" ip saddr != __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-lan " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr != __LAN_NET__ drop
        iifname "__WAN_IF__" ip saddr __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-wan " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" ip saddr __LAN_NET__ drop
        # A LAN source is only valid on the LAN interface (loopback was
        # accepted above).
        iifname != "__LAN_IF__" ip saddr __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-lan " group __DROP_LOG_GROUP__
        iifname != "__LAN_IF__" ip saddr __LAN_NET__ drop

        # fail2ban-banned source toward the host. The portal and DHCP are exceptions:
        # a banned client can still reach the login page (where it sees the reason for
        # the ban), and its DHCP address is not lost either. Every other host
        # service (SSH, DNS, ICMP) and forward traffic is dropped,
        # even if a pre-auth rule would allow it. The portal records the fact of the ban
        # as a single drop-log event; packets logged with sampling during the ban are
        # assigned to this event. As in forward, replies to the gateway's own
        # connections (DNS upstream, NTP, ACME) are not dropped.
        iifname "__LAN_IF__" udp sport 68 udp dport 67 accept
        iifname "__LAN_IF__" tcp dport __PORT__ accept
        ip saddr __PORTAL_NET__ tcp dport __PORT__ accept
        ip saddr @banned_v4 ct direction original limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=fail2ban " group __DROP_LOG_GROUP__
        ip saddr @banned_v4 ct direction original drop

        # The admin-configured block also applies to LAN traffic toward the host.
        # Host permissions and existing host connections cannot bypass it. The
        # earlier acceptance of loopback, breakglass, DHCP and the portal remains
        # untouched, so a block entry cannot lock out the portal or emergency
        # access. The block chain matches the conntrack original tuple, so it runs
        # for every packet; no conntrack flush is needed.
        # Only the original direction: a reply packet in the input chain belongs
        # to a connection the host itself opened (ACME, image pulls), and its
        # original tuple names the remote server, so a destination-less block
        # entry would otherwise cut the host's own outbound traffic.
        # Only from the LAN interface (DJ-33): block entries restrict the LAN
        # clients, so a destination-less entry (for example TCP 443) must not
        # stop inbound WAN traffic to the host (Caddy, tunnels, port proxies).
        # The forward jump above stays unconditional.
        iifname "__LAN_IF__" ct direction original jump block

        # Pre-login host (input) permissions. The block has already run,
        # so the block overrides this too; it stands before the portal and SSH rules
        # so that the given host port is reachable before login.
        jump preauth_input

        # Authorized traffic toward the host (SSH, DNS, ICMP) can also come from the
        # LAN only with the MAC recorded during the session. This does not affect the
        # portal's traffic, because the portal's IP is not in the dynamic sets.
        iifname "__LAN_IF__" ip saddr @allowed_v4 ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr @allowed_v4 ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" ip saddr @allowed_icmp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr @allowed_icmp ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" udp dport 53 ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" udp dport 53 ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" tcp dport 53 ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" tcp dport 53 ip saddr . ether saddr != @client_mac drop
        # Ports of host (input) rules are also reachable from the LAN only with the
        # recorded MAC, just like the forward permissions.
        iifname "__LAN_IF__" ip saddr . tcp dport @allowed_input_tcp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr . tcp dport @allowed_input_tcp ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" ip saddr . udp dport @allowed_input_udp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr . udp dport @allowed_input_udp ip saddr . ether saddr != @client_mac drop

        # Caddy subdomain proxy (only with HV_PROXY=1; otherwise the entrypoint
        # comments it out). Deliberately AFTER the fail2ban drop, the block and the
        # MAC check: a banned source cannot reach the proxy either. Caddy asks the
        # portal for authorization per request, so the port is public; from the LAN
        # (hairpin) only with a fixed IP+MAC pair. It is placed before the host guards
        # so that a stale host rule's 80/443 guard entry does not cut the proxy
        # connections. The TCP 80 of an unauthorized LAN client is still redirected
        # to the portal by prerouting; that of an authorized one is not, so port 80 is
        # also needed on the LAN. The 80/443 of a proxy-banned source is dropped before
        # the proxy acceptance, regardless of HV_PROXY (harmless with the proxy disabled).
        # It is state-independent, so it cuts existing connections too.
        ip saddr @proxy_banned_v4 tcp dport { 80, 443 } limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=proxy-ban " group __DROP_LOG_GROUP__
        ip saddr @proxy_banned_v4 tcp dport { 80, 443 } drop
        # Port proxy (input): the redirected flow passes only if the
        # (client IP, ORIGINAL listening port) pair is in the allowed_input_* set;
        # otherwise it is dropped per packet, with logging (reason=portproxy),
        # so a revoked permission cuts the existing connection too. It runs after
        # the fail2ban drop, the block, the MAC and proxy ban checks, but before
        # the 80/443 proxy acceptance, the host guards and the established accept:
        # thus the redirect target (e.g. 443) does not open anything for an
        # unauthorized client either. No separate rule is needed for the forward proxy:
        # the forward chain's ct original rule permits it.
        jump portproxy_input
        # WireGuard tunnel: the cloud UDP port opens only when the agent is enabled
        # (the portal fills the chain). The fail2ban drop, the block and the MAC check
        # have already run, so they apply here too.
        jump tunnel_input
        __PROXY__iifname "__WAN_IF__" tcp dport { 80, 443 } accept
        __PROXY__iifname "__LAN_IF__" tcp dport { 80, 443 } ip saddr . ether saddr @client_mac accept

        # An existing TCP DNS connection must not stay alive after the permission
        # expires either. UDP gets the same guard: a client that keeps one source
        # port keeps its conntrack entry established, and without the guard its
        # queries would fall through to the general established accept after
        # revocation (a DNS tunnel). We exclude the allowed host (input)
        # TCP/UDP 53 rule: the host connection's actual permission is checked by the
        # host_service_* guard below, so the DNS guard does not break it during the
        # rule's lifetime.
        iifname "__LAN_IF__" tcp dport 53 ct state established,related \
            ip saddr != @allowed_v4 ip saddr . tcp dport != @allowed_tcp \
            ip saddr . tcp dport != @allowed_input_tcp limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=dns-revoked " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" tcp dport 53 ct state established,related \
            ip saddr != @allowed_v4 ip saddr . tcp dport != @allowed_tcp \
            ip saddr . tcp dport != @allowed_input_tcp drop
        iifname "__LAN_IF__" udp dport 53 ct state established,related \
            ip saddr != @allowed_v4 ip saddr . udp dport != @allowed_udp \
            ip saddr . udp dport != @allowed_input_udp limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=dns-revoked " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" udp dport 53 ct state established,related \
            ip saddr != @allowed_v4 ip saddr . udp dport != @allowed_udp \
            ip saddr . udp dport != @allowed_input_udp drop

        # An existing SSH connection stays alive only while the (IP, 22) pair is in
        # the allowed_input_tcp set, i.e. while the host rule assigned to the user
        # that allows TCP 22 is active. If the permission disappears (after expiry,
        # logout, or even a crash), the connection closes. This rule is placed before
        # the general established-accept below, otherwise the revoked SSH would survive.
        tcp dport 22 ct state established,related ip saddr . tcp dport != @allowed_input_tcp limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=ssh-revoked " group __DROP_LOG_GROUP__
        tcp dport 22 ct state established,related ip saddr . tcp dport != @allowed_input_tcp drop

        # The host DNS service (53) is reachable by a client with forward permission
        # even in the established state, under the same conditions as the later LAN
        # accept rules. This narrow exception applies only to DNS/53, so it does not
        # open a path toward the host services. DHCP (needed even before login to
        # keep the address) passes before the host guard in the same way, so a stale
        # host_service_udp 67 entry does not break renewal.
        iifname "__LAN_IF__" tcp dport 53 ct state established,related ip saddr @allowed_v4 accept
        iifname "__LAN_IF__" tcp dport 53 ct state established,related ip saddr . tcp dport @allowed_tcp accept
        iifname "__LAN_IF__" udp dport 53 ct state established,related ip saddr @allowed_v4 accept
        iifname "__LAN_IF__" udp dport 53 ct state established,related ip saddr . udp dport @allowed_udp accept
        iifname "__LAN_IF__" udp sport 68 udp dport 67 accept

        # An existing host (input) connection must not stay alive either if the IP
        # was removed from the allowed_input_tcp/allowed_input_udp set. The input chain
        # sees only client→host packets toward the host services; the destination port
        # of portal-redirected packets is already the portal port at that point, so the
        # packet-level tcp/udp dport is the correct key. The DNS/53 and DHCP accept rules are above;
        # for every other host port the host_service_* sets (add-only) close the flow
        # when the permission disappears. Thus it closes even when the conntrack flush
        # is omitted and when nf_conntrack_tcp_loose revives the flow.
        # Port TCP 22 is deliberately excluded from the general guard: TCP 22 is
        # exclusively the domain of the SSH-specific guard (above), so the same
        # connection is not decided in two places. The UDP guard gets no such
        # exception: the SSH guard is TCP-only, and UDP 22 is an ordinary host port.
        # Only the original direction is checked: for the replies of the host's
        # own outbound connections the dport is a local ephemeral port, which a
        # host rule range may cover.
        tcp dport @host_service_tcp tcp dport != 22 ct state established,related ct direction original \
            ip saddr . tcp dport != @allowed_input_tcp \
            limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=host-revoked " group __DROP_LOG_GROUP__
        tcp dport @host_service_tcp tcp dport != 22 ct state established,related ct direction original \
            ip saddr . tcp dport != @allowed_input_tcp drop
        udp dport @host_service_udp ct state established,related ct direction original \
            ip saddr . udp dport != @allowed_input_udp \
            limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=host-revoked " group __DROP_LOG_GROUP__
        udp dport @host_service_udp ct state established,related ct direction original \
            ip saddr . udp dport != @allowed_input_udp drop

        ct state established,related accept

        # ICMP toward the host only for an allowed client, and only ping.
        # Related ICMP errors pass through the established,related rule above;
        # pre-login ping is not an access path.
        iifname "__LAN_IF__" ip saddr @allowed_v4 icmp type echo-request accept
        iifname "__LAN_IF__" ip saddr @allowed_icmp icmp type echo-request accept

        # The login page is reachable by everyone. From the LAN always;
        # __PORTAL_NET__ is the portal source network, with 0.0.0.0/0
        # it is public too.
        iifname "__LAN_IF__" tcp dport __PORT__ accept
        ip saddr __PORTAL_NET__ tcp dport __PORT__ accept

        # Host (input) rule: the portal machine's own service for the logged-in
        # client's IP. There is no iifname condition, so it works from both LAN and
        # WAN; the fail2ban and MAC drop rules run first.
        # This is also the only SSH acceptance path: TCP 22 opens only if a host
        # rule created by an admin and assigned to the user explicitly includes it,
        # and the session is active. The portal adds the IP after the rule and TTL
        # are selected; the password alone does not. It is removed immediately on
        # logout, and on expiry via the kernel timeout. The portal port remains
        # reserved, and this rule excludes it too (protection against manually
        # added elements). For direct emergency access, a separate breakglass rule
        # can be used.
        ip saddr . tcp dport @allowed_input_tcp tcp dport != __PORT__ accept
        ip saddr . udp dport @allowed_input_udp udp dport != __PORT__ accept

        # The host DNS service (dnsmasq) is reachable only based on the selected rule.
        # Without this, a DNS tunnel through the host would be open even before the
        # portal, bypassing the forward rules.
        iifname "__LAN_IF__" ip saddr @allowed_v4 udp dport 53 accept
        iifname "__LAN_IF__" ip saddr . udp dport @allowed_udp udp dport 53 accept
        iifname "__LAN_IF__" ip saddr @allowed_v4 tcp dport 53 accept
        iifname "__LAN_IF__" ip saddr . tcp dport @allowed_tcp tcp dport 53 accept

        # Logging of incoming traffic not authorized for the portal. The chain's
        # policy is drop; the limit only restricts logging.
        iifname "__LAN_IF__" limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=input-lan " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=input-wan " group __DROP_LOG_GROUP__
    }

    chain prerouting {
        # We drop the configured blocked TCP 80 before the portal redirect;
        # and pre-auth TCP 80 gets a conntrack mark so that it can bypass
        # the redirect below with a return.
        iifname "__LAN_IF__" jump block_nat
        iifname "__LAN_IF__" jump preauth_nat
        iifname "__LAN_IF__" ct mark 0x50524541 return

        # Those not yet authorized are sent to the login page over HTTP (80).
        # Full access and port-restricted access also bypass the redirect,
        # otherwise traffic would be directed to the portal despite the TCP 80 permission.
        iifname "__LAN_IF__" ip saddr @allowed_v4 return
        # Docker's DNAT may run in the same prerouting section, so here too the
        # port before DNAT must be examined, otherwise the published container port's
        # traffic would be wrongly directed to the portal. The meta l4proto prefix
        # is needed here too for the concat type.
        iifname "__LAN_IF__" meta l4proto tcp ip saddr . ct original proto-dst @allowed_tcp return
        iifname "__LAN_IF__" meta l4proto udp ip saddr . ct original proto-dst @allowed_udp return
        # TCP 80 opened by the host rule (the portal machine's own service) also
        # bypasses the portal redirect; there is no redirect for UDP.
        iifname "__LAN_IF__" meta l4proto tcp ip saddr . ct original proto-dst @allowed_input_tcp return
        iifname "__LAN_IF__" meta l4proto tcp ct original proto-dst 80 redirect to :__PORT__
    }

    chain postrouting {
        # The requested SNAT of the forward port proxy before the general masquerade.
        jump portproxy_snat
        oifname "__WAN_IF__" ip saddr __LAN_NET__ masquerade
    }

    chain portproxy_prerouting {
        jump portproxy_nat
    }

    chain loopback_guard {
        # IPv6 never gets past the first hook either (the input and forward
        # chains drop it too): no NAT rule and no later chain sees it.
        iifname != "lo" meta nfproto ipv6 drop
        iifname != "lo" ip daddr 127.0.0.0/8 drop
        iifname != "lo" ip saddr 127.0.0.0/8 drop
    }
}
