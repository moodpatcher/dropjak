[Unit]
Description=Dropjak — network gateway
Documentation=file:///opt/hatarvedelem/README.md
# The firewall rules are in a separate, early-starting unit. The portal only
# starts once those have been loaded. Every privileged network operation runs
# in dropjak-helper.service (DJ-20); the portal starts after it and waits for
# its socket. Wants= (not Requires=): a helper restart must never stop the
# portal, which only refuses grants until the helper answers again.
After=network.target dropjak-firewall.service dropjak-helper.service
Wants=network.target dropjak-helper.service
Requires=dropjak-firewall.service

[Service]
Type=simple
User=hatarvedelem
Group=hatarvedelem
WorkingDirectory=/opt/hatarvedelem

Environment=PORT=__PORT__
Environment=HV_STATE_DIR=/var/lib/hatarvedelem
Environment=HV_USERS=/var/lib/hatarvedelem/users.json
Environment=HV_RULES=/var/lib/hatarvedelem/rules.json
Environment=HV_GROUPS=/var/lib/hatarvedelem/groups.json
Environment=HV_AUDIT_LOG=/var/lib/hatarvedelem/audit.jsonl
Environment=HV_AUDIT_MAX_BYTES=10485760
Environment=HV_AUDIT_KEEP=5
Environment=HV_SERVICES_FILE=/opt/hatarvedelem/services.json
# Startup admin account (optional). Do not put the password in the unit file
# (unit files are world-readable, and the variable stays in the process
# environment). Store it in a root-only file and pass it as a credential:
# Environment=HV_ADMIN_ENABLED=1
# Environment=HV_ADMIN_USER=admin
# LoadCredential=admin-password:/etc/dropjak/admin-password
# Environment=HV_ADMIN_PASSWORD_FILE=%d/admin-password
# Set HV_ADMIN_ENABLED=0 after the first start: while it is on, every start
# re-enables the account and restores its admin role.
Environment=HV_PORTAL_URL=__PORTAL_URL__
Environment=HV_NFT_TABLE=hatarvedelem
Environment=HV_NFT_SET=allowed_v4
Environment=HV_NFT_BIN=__NFT_BIN__
# The privileged helper's socket (dropjak-helper.service).
Environment=HV_PRIV_HELPER=/run/dropjak/helper.sock
Environment=HV_SESSION_TTL=3600
Environment=HV_POW_DIFFICULTY=4
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=__PYTHON__ /opt/hatarvedelem/server.py
Restart=on-failure
RestartSec=2

StateDirectory=hatarvedelem
StateDirectoryMode=0750
# /run/dropjak (the helper socket) belongs to dropjak-helper.service; the
# portal only connects to the socket there.
UMask=0077

# The server is not root and holds no network privilege: nftables,
# conntrack and WireGuard run in dropjak-helper.service. Only a portal
# port below 1024 keeps CAP_NET_BIND_SERVICE (filled in by install.sh;
# empty means no capability at all).
AmbientCapabilities=__BIND_CAPS__
CapabilityBoundingSet=__BIND_CAPS__
NoNewPrivileges=yes

# Sandboxing.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ProtectProc/ProcSubset is only available from systemd 247; the systemd
# on RHEL 8 and Ubuntu 20.04 does not know it yet, so it is not here.
ReadOnlyPaths=/opt/hatarvedelem
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
