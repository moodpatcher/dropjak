[Unit]
Description=Dropjak — network gateway
Documentation=file:///opt/hatarvedelem/README.md
# The firewall rules are in a separate, early-starting unit. The portal only
# starts once those have been loaded.
After=network.target dropjak-firewall.service
Wants=network.target
Requires=dropjak-firewall.service

[Service]
Type=simple
User=hatarvedelem
Group=hatarvedelem
WorkingDirectory=/opt/hatarvedelem

Environment=PORT=__PORT__
Environment=HV_STATE_DIR=/var/lib/hatarvedelem
Environment=HV_USERS=/var/lib/hatarvedelem/users.json
Environment=HV_RULES=/var/lib/hatarvedelem/rules.json
Environment=HV_GROUPS=/var/lib/hatarvedelem/groups.json
Environment=HV_AUDIT_LOG=/var/lib/hatarvedelem/audit.jsonl
Environment=HV_AUDIT_MAX_BYTES=10485760
Environment=HV_AUDIT_KEEP=5
Environment=HV_SERVICES_FILE=/opt/hatarvedelem/services.json
# Startup admin account (optional). If you enable it, all three lines are required.
# The password is stored in the unit file as plain text; the file must be 0600.
# Environment=HV_ADMIN_ENABLED=1
# Environment=HV_ADMIN_USER=admin
# Environment=HV_ADMIN_PASSWORD=change-me
Environment=HV_PORTAL_URL=__PORTAL_URL__
Environment=HV_NFT_TABLE=hatarvedelem
Environment=HV_NFT_SET=allowed_v4
Environment=HV_NFT_BIN=__NFT_BIN__
Environment=HV_SESSION_TTL=3600
Environment=HV_POW_DIFFICULTY=4
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=__PYTHON__ /opt/hatarvedelem/server.py
Restart=on-failure
RestartSec=2

StateDirectory=hatarvedelem
StateDirectoryMode=0750
# The 0600 temporary files for the WireGuard keys go here; the portal
# does not run as root, so systemd creates them with its privileges (with
# ProtectSystem, /run is otherwise not writable).
RuntimeDirectory=dropjak
RuntimeDirectoryMode=0700
UMask=0077

# The server is not root: privileges are only needed for nftables and port 80.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Sandboxing.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ProtectProc/ProcSubset is only available from systemd 247; the systemd
# on RHEL 8 and Ubuntu 20.04 does not know it yet, so it is not here.
ReadOnlyPaths=/opt/hatarvedelem
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
