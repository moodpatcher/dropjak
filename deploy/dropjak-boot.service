[Unit]
Description=Dropjak — early forward block (before Docker)
Documentation=file:///opt/hatarvedelem/README.md
# We load it before Docker so that no uncontrolled traffic passes until the
# container starts. After the final rules are loaded, the container deletes
# this table.
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target docker.service shutdown.target
After=nftables.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=__NFT_BIN__ -f /etc/nftables/dropjak-boot.nft
ExecReload=__NFT_BIN__ -f /etc/nftables/dropjak-boot.nft
# Deliberately no ExecStop: stopping must not open the forward chain.
# Removal is a deliberate operation:
#   nft delete table inet hatarvedelem_boot

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=sysinit.target
