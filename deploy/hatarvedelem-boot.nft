#!/usr/sbin/nft -f
#
# Dropjak — korai boot-védelem Dockeres telepítéshez
#
# A Docker daemon csak a rendszer indítása után áll fel. A konténer addig
# nem tudja betölteni a végleges szabályokat, ezért ebben az időablakban
# szabályozatlan forgalom mehetne át, és az SSH is nyitva lehetne. Ezt a
# szűk táblát a hoston egy korai systemd unit tölti be
# (hatarvedelem-boot.service), a konténer belépési pontja pedig a végleges
# szabályok betöltése után törli.
#
# A forward-lánc mellett az input 22-es portját is eldobja: a host SSH a
# portál indulása előtt nem lehet elérhető. A portál a végleges szabályok
# betöltése után veszi át a helyét. A tábla IDEMPOTENS módon tölthető újra.
#
# Kézi betöltés:  nft -f /etc/nftables/hatarvedelem-boot.nft
# Eltávolítás:    nft delete table inet hatarvedelem_boot

add table inet hatarvedelem_boot

add chain inet hatarvedelem_boot forward {
    type filter hook forward priority filter; policy drop;
}

add chain inet hatarvedelem_boot input {
    type filter hook input priority filter; policy accept;
}

add chain inet hatarvedelem_boot loopback_guard {
    type filter hook prerouting priority raw; policy accept;
}

flush chain inet hatarvedelem_boot forward
flush chain inet hatarvedelem_boot input
flush chain inet hatarvedelem_boot loopback_guard

# A portál még nem fut, ezért a host SSH-t a végleges szabályok
# betöltéséig mindenhonnan eldobjuk. A loopback kivétel, hogy a helyi
# adminisztráció ne akadjon el.
table inet hatarvedelem_boot {
    chain input {
        iifname "lo" accept
        tcp dport 22 drop
    }

    # A hoston net.ipv4.conf.all.route_localnet=1 (az input port proxy
    # loopback-céljához): a kívülről érkező 127/8 célú vagy forrású csomag
    # a végleges szabályok betöltése előtt sem érheti el a loopback
    # szolgáltatásokat.
    chain loopback_guard {
        iifname != "lo" ip daddr 127.0.0.0/8 drop
        iifname != "lo" ip saddr 127.0.0.0/8 drop
    }
}
