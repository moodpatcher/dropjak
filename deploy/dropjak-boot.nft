#!/usr/sbin/nft -f
#
# Dropjak — early boot protection for Docker-based installations
#
# The Docker daemon only comes up after the system has started. Until then,
# the container cannot load the final rules, so during this time window
# unfiltered traffic could pass through, and SSH could also be open. This
# narrow table is loaded on the host by an early systemd unit
# (dropjak-boot.service), and the container entrypoint deletes it
# after loading the final rules.
#
# Besides the forward chain, the input chain is closed as well (policy drop):
# host SSH, DNS and every other host service must not be reachable before
# the portal starts, and this table stays in place if the container exits
# before loading the final rules (for example with an invalid .env). The
# portal takes over after the final rules are loaded. The table can be
# reloaded IDEMPOTENTLY.
#
# Manual load:  nft -f /etc/nftables/dropjak-boot.nft
# Removal:      nft delete table inet hatarvedelem_boot

add table inet hatarvedelem_boot

add chain inet hatarvedelem_boot forward {
    type filter hook forward priority filter; policy drop;
}

add chain inet hatarvedelem_boot input {
    type filter hook input priority filter; policy drop;
}

add chain inet hatarvedelem_boot loopback_guard {
    type filter hook prerouting priority raw; policy accept;
}

flush chain inet hatarvedelem_boot forward
flush chain inet hatarvedelem_boot input
flush chain inet hatarvedelem_boot loopback_guard

# The portal is not running yet, so host input is dropped from everywhere
# until the final rules are loaded. Exceptions: loopback, so that local
# administration is not blocked; replies to the host's own outbound
# connections (Docker image pulls, NTP, DNS lookups); and DHCP requests, so
# LAN clients keep their addresses. Host SSH (TCP 22) stays closed; use the
# provider console during this window. IPv6 is dropped everywhere except on
# loopback; the forward chain has no rule, so its policy drops everything.
table inet hatarvedelem_boot {
    chain input {
        iifname "lo" accept
        # IPv6 is always dropped, replies included (see dropjak.nft).
        meta nfproto ipv6 drop
        tcp dport 22 drop
        ct state established,related accept
        udp sport 68 udp dport 67 accept
    }

    # On the host net.ipv4.conf.all.route_localnet=1 (for the input port proxy
    # loopback target): packets with a destination or source in 127/8 from
    # outside must not reach the loopback services before the final rules are loaded.
    chain loopback_guard {
        iifname != "lo" meta nfproto ipv6 drop
        iifname != "lo" ip daddr 127.0.0.0/8 drop
        iifname != "lo" ip saddr 127.0.0.0/8 drop
    }
}
