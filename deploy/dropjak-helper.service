[Unit]
Description=Dropjak — privileged helper (nft, conntrack, WireGuard)
Documentation=file:///opt/hatarvedelem/README.md
# The portal (dropjak.service) holds no CAP_NET_ADMIN (DJ-20): every nft,
# conntrack, WireGuard and NFLOG operation runs here, behind the Unix socket
# /run/dropjak/helper.sock (directory 0750 root:hatarvedelem, socket 0660).
# The helper accepts only the portal user and root (SO_PEERCRED) and a fixed
# JSON command set. It starts after the rules are loaded and before the
# portal; the portal waits for its socket and refuses grants while it does
# not answer.
After=network.target dropjak-firewall.service
Wants=network.target
Before=dropjak.service

[Service]
Type=simple
# Root, so it owns the socket and the 0600 WireGuard key files in the
# root-owned runtime directory; the group makes the socket reachable for
# the portal. Only CAP_NET_ADMIN is kept.
User=root
Group=hatarvedelem
WorkingDirectory=/opt/hatarvedelem

Environment=PORT=__PORT__
Environment=HV_STATE_DIR=/var/lib/hatarvedelem
Environment=HV_NFT_TABLE=hatarvedelem
Environment=HV_NFT_SET=allowed_v4
Environment=HV_NFT_BIN=__NFT_BIN__
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=__PYTHON__ /opt/hatarvedelem/privhelper.py --socket /run/dropjak/helper.sock
# A crashed helper is restarted at once; the portal keeps running and only
# refuses grants meanwhile (never a lockout by a restart loop of the portal).
Restart=always
RestartSec=1

# The socket directory, shared with the portal through the group. Kept
# across helper restarts so the portal's staged files stay in place.
RuntimeDirectory=dropjak
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077

CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes

# Sandboxing.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/opt/hatarvedelem
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
