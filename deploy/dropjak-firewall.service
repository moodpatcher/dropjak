[Unit]
Description=Dropjak — nftables firewall rules
Documentation=file:///opt/hatarvedelem/README.md
# The distribution's own nftables.service (if present) should load its
# rules first; ours follows afterwards, so neither overwrites the other
# due to an accidental ordering. If no such unit exists, After= has no effect.
After=nftables.service
# A distribution config that starts with "flush ruleset" (the Debian default)
# deletes our table on every nftables restart or reload. With these, systemd
# reloads our rules right after it, and the portal notices the new table and
# refills its chains and sets.
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service
# The rules should reach the kernel before the network comes up. Because of
# iifname/oifname, the interfaces do not need to exist yet for this.
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# nft -f is idempotent: the rules are replaced, while the dynamic set
# elements (the clients that have logged in) are preserved.
ExecStart=__NFT_BIN__ -f /etc/nftables/dropjak.nft
ExecReload=__NFT_BIN__ -f /etc/nftables/dropjak.nft
# There is deliberately no ExecStop: stopping the service must not open
# the network. Removing the rules is a separate, deliberate operation:
#   nft delete table inet hatarvedelem

# nft runs as root, but only with the capability needed for network
# rules. The file is owned by root and is 0600, so it can be read.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=sysinit.target
