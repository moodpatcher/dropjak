[Unit]
Description=Dropjak — hálózati belépőkapu
Documentation=file:///opt/hatarvedelem/README.md
# A tűzfalszabályok külön, korán induló unitban vannak. A portál csak
# akkor indul el, ha azok betöltődtek.
After=network.target hatarvedelem-firewall.service
Wants=network.target
Requires=hatarvedelem-firewall.service

[Service]
Type=simple
User=hatarvedelem
Group=hatarvedelem
WorkingDirectory=/opt/hatarvedelem

Environment=PORT=__PORT__
Environment=HV_STATE_DIR=/var/lib/hatarvedelem
Environment=HV_USERS=/var/lib/hatarvedelem/users.json
Environment=HV_RULES=/var/lib/hatarvedelem/rules.json
Environment=HV_GROUPS=/var/lib/hatarvedelem/groups.json
Environment=HV_AUDIT_LOG=/var/lib/hatarvedelem/audit.jsonl
Environment=HV_AUDIT_MAX_BYTES=10485760
Environment=HV_AUDIT_KEEP=5
Environment=HV_SERVICES_FILE=/opt/hatarvedelem/services.json
# Induláskori admin fiók (opcionális). Ha bekapcsolod, mindhárom sor kell.
# A jelszó a unit fájlban egyszerű szövegként szerepel; a fájl legyen 0600.
# Environment=HV_ADMIN_ENABLED=1
# Environment=HV_ADMIN_USER=admin
# Environment=HV_ADMIN_PASSWORD=valtoztasd-meg
Environment=HV_PORTAL_URL=__PORTAL_URL__
Environment=HV_NFT_TABLE=hatarvedelem
Environment=HV_NFT_SET=allowed_v4
Environment=HV_NFT_BIN=__NFT_BIN__
Environment=HV_SESSION_TTL=3600
Environment=HV_POW_DIFFICULTY=4
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=__PYTHON__ /opt/hatarvedelem/server.py
Restart=on-failure
RestartSec=2

StateDirectory=hatarvedelem
StateDirectoryMode=0750
UMask=0077

# A szerver nem root: csak az nftables-hez és a 80-as porthoz kell képesség.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Kármentesítés.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# A ProtectProc/ProcSubset csak systemd 247-től elérhető; a RHEL 8 és az
# Ubuntu 20.04 systemd-je még nem ismeri, ezért nincsenek itt.
ReadOnlyPaths=/opt/hatarvedelem
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
