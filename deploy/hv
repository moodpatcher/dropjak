#!/bin/bash
# Dropjak — local management command on the VM.
set -euo pipefail

APP=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
BACKUPS=${HV_BACKUPS:-/root/dropjak-backups}
STATE_VOLUME=/var/lib/docker/volumes/dropjak-state/_data

cd "$APP"

usage() {
    cat <<'EOF'
Usage: hv <command>

  status            status of the container, portal and nft sets
  logs              follow logs (Ctrl+C to exit)
  restart           restart, re-reading .env
  start [args]      careful start with preflight and health wait (start.sh)
  stop [args]       graceful stop; the firewall stays loaded (stop.sh)
  rebuild           rebuild and start (after code / services.json providing the initial rules)
  edit              edit .env
  services          edit services.json (initial rules/migration; then hv rebuild)
  users             list users
  add <name> [--no-must-change]   new user (prompts for password interactively)
  passwd <name> [--no-must-change] change password (interactively)
  del <name>        delete user
  backup            back up to /root/dropjak-backups
  test              local unit and HTTP tests
  e2e               full test from the hvclient namespace (about 2 minutes)
  where             list important files and locations
EOF
}

need_name() {
    local command=$1
    shift
    if [ "$#" -ne 1 ]; then
        echo "Usage: hv $command <name>" >&2
        exit 2
    fi
}

portal_port() {
    local value
    value=$(sed -n 's/^PORT=//p' "$APP/.env" 2>/dev/null | tail -n1)
    echo "${value:-8100}"
}

server_cli() {
    docker compose exec -T --user hatarvedelem dropjak \
        python3 /opt/hatarvedelem/server.py "$@"
}

case "${1:-}" in
    status)
        docker compose ps
        echo
        port=$(portal_port)
        if curl -sS -m 5 -o /dev/null "http://127.0.0.1:${port}/api/status"; then
            echo "portal: HTTP 200 (${port})"
        else
            echo "portal: NOT RESPONDING (${port})" >&2
        fi
        echo
        echo "nftables sets:"
        nft list sets inet hatarvedelem 2>/dev/null \
            | grep -E '^[[:space:]]*set |elements' || true
        ;;
    logs)
        docker compose logs -f --tail=100
        ;;
    restart)
        docker compose up -d
        ;;
    start|stop)
        command=$1
        shift
        exec "$APP/$command.sh" "$@"
        ;;
    rebuild)
        # The fail-closed forward chain blocks the build container's egress,
        # and Compose cannot grant BuildKit the network.host entitlement.
        DOCKER_BUILDKIT=0 docker build --network host -t dropjak:2 . || exit 1
        docker compose up -d --force-recreate
        ;;
    edit)
        editor=${EDITOR:-}
        if [ -z "$editor" ]; then
            if command -v nano >/dev/null 2>&1; then editor=nano; else editor=vi; fi
        fi
        "$editor" "$APP/.env"
        echo "After changes: hv restart"
        ;;
    services)
        editor=${EDITOR:-}
        if [ -z "$editor" ]; then
            if command -v nano >/dev/null 2>&1; then editor=nano; else editor=vi; fi
        fi
        "$editor" "$APP/services.json"
        echo "After changes: hv rebuild"
        ;;
    users)
        server_cli user list
        ;;
    add)
        shift
        if [ "$#" -lt 1 ]; then
            echo "Usage: hv add <name> [--no-must-change]" >&2
            exit 2
        fi
        docker compose exec --user hatarvedelem dropjak \
            python3 /opt/hatarvedelem/server.py user add "$@"
        ;;
    passwd)
        shift
        if [ "$#" -lt 1 ]; then
            echo "Usage: hv passwd <name> [--no-must-change]" >&2
            exit 2
        fi
        docker compose exec --user hatarvedelem dropjak \
            python3 /opt/hatarvedelem/server.py user passwd "$@"
        ;;
    del)
        shift
        need_name del "$@"
        server_cli user del "$1"
        ;;
    backup)
        mkdir -p "$BACKUPS"
        chmod 700 "$BACKUPS"
        ts=$(date +%Y%m%d-%H%M%S)
        tar -czf "$BACKUPS/hatarvedelem-$ts.tar.gz" -C /root hatarvedelem
        # The complete state: users.json, rules.json, groups.json, audit log
        # and the rotated log files. .lock files may also be included; these
        # are harmless on restore.
        if [ -d "$STATE_VOLUME" ]; then
            tar -czf "$BACKUPS/dropjak-state-$ts.tar.gz" -C "$STATE_VOLUME" .
            state_backup="$BACKUPS/dropjak-state-$ts.tar.gz"
        else
            echo "WARNING: state volume not found: $STATE_VOLUME" >&2
            state_backup=""
        fi
        chmod 600 "$BACKUPS/hatarvedelem-$ts.tar.gz"
        echo "Backup complete:"
        echo "  $BACKUPS/hatarvedelem-$ts.tar.gz"
        if [ -n "$state_backup" ]; then
            chmod 600 "$state_backup"
            echo "  $state_backup"
        fi
        ;;
    test)
        python3 -m unittest discover -s "$APP/tests"
        ;;
    e2e)
        python3 "$APP/tests/e2e_vm.py"
        ;;
    where)
        # The local guide is section 2 of DOKUMENTACIO.md (up to the next anchor).
        awk '/^## 2\. /{p=1} p&&/^<a id=/{exit} p' "$APP/DOKUMENTACIO.md"
        ;;
    ""|help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo >&2
        usage >&2
        exit 2
        ;;
esac
