#!/usr/sbin/nft -f
#
# Dropjak — nftables szabályok
#
# Ezt a fájlt az install.sh generálja a helyőrzők helyettesítésével.
# Kézi szerkesztés után: nft -c -f /etc/nftables/hatarvedelem.nft
#
# A fájl IDEMPOTENS: többszöri betöltés után sem duplázódnak a szabályok,
# és az allowed_v4 halmaz elemei megmaradnak. Ezt használja a
# hatarvedelem-firewall.service ExecReload-ja is.
#
# Alapelv:
#   - forward: minden tiltva; a belépett kliens csak a választott szabály
#     TCP/UDP célportjaira mehet (allowed_tcp/allowed_udp), ICMP-re az
#     allowed_icmp révén; teljes hozzáférésnél az allowed_v4 halmaz tagjaként
#   - input:   a portál mindenki számára elérhető; a host SSH (TCP 22)
#     kizárólag egy admin által létrehozott, a felhasználóhoz rendelt host
#     (input) szabályon keresztül nyílik meg (allowed_input_tcp, explicit
#     22), aktív, engedélyezett portál-munkamenettel; a DNS/DHCP a LAN felől
#   - a nem engedélyezett kliensek HTTP-je a belépőoldalra kerül
#
# Az iifname/oifname használatának oka, hogy a szabályok betöltése ne
# függjön attól, hogy az adott interfész (VLAN, bridge, bond) a boot során
# mikor jön létre. Ha az interfész nem létezik, a szabály nem illeszkedik,
# tehát a forgalom tiltva marad (fail-closed).

# A tábla, a halmaz és a láncok létrehozása. Ha már léteznek, ezek a
# parancsok nem változtatnak rajtuk.
add table inet hatarvedelem

# Ide kerülnek a teljes hozzáférést választó kliensek IPv4 címei,
# kerneloldali lejárattal.
add set inet hatarvedelem allowed_v4 {
    type ipv4_addr
    flags timeout
    size 4096
}

# Portra korlátozott hozzáférés: kliens IP + célport párok.
# A portok a kliens által választott szabályból jönnek (rules.json).
add set inet hatarvedelem allowed_tcp {
    type ipv4_addr . inet_service
    flags timeout
    size 16384
}

add set inet hatarvedelem allowed_udp {
    type ipv4_addr . inet_service
    flags timeout
    size 16384
}

# Host (input) szabályok: a portálgép saját szolgáltatásai, amelyeket a
# belépett kliens IP-jének nyitunk meg a munkamenet TTL-jéig. A forward
# halmazoktól külön tároljuk őket, és csak a bejövő (input) lánc fogadja el
# belőlük a forgalmat. Csak a 8100-as port (portál) fenntartott: a portál
# validációja nem engedi ide felvenni, és a lenti elfogadó szabály is
# kizárja. A 22-es portot adminisztrátor által létrehozott host szabály
# deklarálhatja; a host elfogadás a 8100-at ettől függetlenül kizárja.
add set inet hatarvedelem allowed_input_tcp {
    type ipv4_addr . inet_service
    flags timeout
    size 16384
}

add set inet hatarvedelem allowed_input_udp {
    type ipv4_addr . inet_service
    flags timeout
    size 16384
}

# A host (input) szabályokban valaha deklarált célportok. A normál
# szinkron ezekbe csak hozzáad: így egy szabály törlése nem nyithatja meg
# újra a már meglévő kapcsolatot. Az input lánc ezekkel vágja el az
# established forgalmat, ha az engedély eltűnik, akkor is, ha a conntrack
# ürítése nem sikerül, vagy a kernel (nf_conntrack_tcp_loose) újraéleszti
# a folyamot. Az elavult portok ártalmatlanok: csak szigorúbbá teszik az
# established forgalom ellenőrzését.
#
# A méret 65536: az érvényes host portok száma legfeljebb 65535, ezért a
# halmaz soha nem telhet meg, és nem veszhet el csendben egy őrelem. A
# takarítás (prune) csak olyan portot töröl, amelyre egyetlen perzisztált
# szabály sem hivatkozik, és amelyhez nem tartozik élő conntrack-bejegyzés.
# Induláskor a halmaz szándékosan nem ürül: a törölt portok régi folyamai
# így továbbra is el vannak vágva.
add set inet hatarvedelem host_service_tcp {
    type inet_service
    size 65536
}

add set inet hatarvedelem host_service_udp {
    type inet_service
    size 65536
}

# ICMP (ping) engedély a kliens IP-hez.
add set inet hatarvedelem allowed_icmp {
    type ipv4_addr
    flags timeout
    size 4096
}

# Klienshez kötött MAC-cím. A forrás-IP önmagában hamisítható a LAN-on
# (más kliens engedélyezett IP-jének felvételével), ezért az engedélyezett
# IP-hez a portál a kliens ARP-bejegyzéséből származó MAC-címet is rögzíti.
# A kapcsolódó drop-szabályok csak a LAN-interfészen érvényesek.
add set inet hatarvedelem client_mac {
    type ipv4_addr . ether_addr
    flags timeout
    size 4096
}

# fail2ban: a túl sok sikertelen belépést elkövető forrás-IP-k. Az elem a
# beállított tiltási idővel jár le; a portál a sikeres tiltás után ide
# teszi az IP-t, feloldáskor azonnal törli. A tiltott forrás csomagjai a
# forward- és az input-láncban is eldobódnak (a portál és a DHCP kivétel).
add set inet hatarvedelem banned_v4 {
    type ipv4_addr
    flags timeout
    size 4096
}

# A forward láncot lentebb, a szabályokkal egy tranzakcióban hozzuk létre,
# -10-es prioritással. Így az a Docker ip filter FORWARD lánca ELŐTT fut, és
# a Docker DOCKER-USER lánca csak az általa megjelölt csomagokat engedi át.
# A csupasz add chain idempotens: létező láncot nem módosít.
add chain inet hatarvedelem forward

# Vészhelyzeti (break-glass) lánc. A sablon betöltése NEM üríti, ezért egy
# ide ideiglenesen felvett SSH-engedély túléli a szabályok újratöltését és
# a portál újraindítását. Alapból üres; a normál forgalomra nincs hatással.
# Használat (majd használat után azonnal törölni kell):
#   nft add rule inet hatarvedelem breakglass \
#       ip saddr 203.0.113.10 tcp dport 22 accept
#   nft delete rule inet hatarvedelem breakglass handle <handle>
add chain inet hatarvedelem breakglass

# Admin által testreszabott láncok. A portál tölti fel őket induláskor és
# beállításmódosításkor; a sablon betöltése nem üríti őket, hogy egy
# újratöltés ne nyissa meg vagy ne zárja el a beállított célokat.
#   preauth:    bejelentkezés előtt is elérhető célok/portok (LAN és válasz)
#   block:      mindig eldobott LAN-forgalom (a pre-auth előtt)
#   preauth_nat: a pre-auth TCP 80 kikerüli a portál-átirányítást
#   block_nat:  a blokkolt TCP 80-at már a redirect előtt eldobja
add chain inet hatarvedelem preauth
add chain inet hatarvedelem block
add chain inet hatarvedelem preauth_nat
add chain inet hatarvedelem block_nat

add chain inet hatarvedelem input {
    type filter hook input priority filter; policy drop;
}

add chain inet hatarvedelem prerouting {
    type nat hook prerouting priority dstnat; policy accept;
}

add chain inet hatarvedelem postrouting {
    type nat hook postrouting priority srcnat; policy accept;
}

# A láncok szabályainak cseréje. A flush és az új szabályok ugyanabban az
# nft-tranzakcióban futnak, ezért nincs nyitott időablak. A halmazhoz nem
# nyúlunk: az újratöltés nem jelentkezteti ki a klienseket.
#
# A forward láncot újra létrehozzuk, hogy a prioritása régi telepítésen is
# -10 legyen. A törlés és az újralétrehozás ugyanabban a tranzakcióban
# történik, tehát nincs olyan pillanat, amikor ne lenne forward-lánc.
flush chain inet hatarvedelem forward
delete chain inet hatarvedelem forward
add chain inet hatarvedelem forward {
    type filter hook forward priority -10; policy drop;
}
flush chain inet hatarvedelem input
flush chain inet hatarvedelem prerouting
flush chain inet hatarvedelem postrouting

table inet hatarvedelem {
    chain forward {
        # IPv6-t nem továbbítunk. Az ip_forward sysctl csak az IPv4-re
        # vonatkozik; ez a szabály akkor is zár, ha az IPv6 forwarding
        # valamilyen okból bekapcsolódna.
        meta nfproto ipv6 limit rate 10/minute burst 20 packets log prefix "dropjak-drop reason=ipv6 " group __DROP_LOG_GROUP__
        meta nfproto ipv6 drop

        # Forrás-IP hamisítás tiltása. A LAN-interfészen csak a LAN
        # hálózatához tartozó forrás jöhet be; a WAN felől pedig tilos a
        # LAN címét felvenni. Ez zárja ki, hogy egy kliens egy másik,
        # engedélyezett kliens IP-jével (vagy LAN-forrással a WAN felől)
        # használja a forward-szabályokat.
        iifname "__LAN_IF__" ip saddr != __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-lan " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr != __LAN_NET__ drop
        iifname "__WAN_IF__" ip saddr __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-wan " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" ip saddr __LAN_NET__ drop

        # fail2ban-tiltott forrás: a továbbított forgalom naplózott
        # eldobása. Ez a szabály az engedélyező halmazok és a pre-auth lánc
        # előtt fut, ezért egy korábban megnyitott vagy pre-auth hozzáférés
        # sem érvényesül a tiltás alatt. A naplózás mintavételezett (a limit
        # csak a logot korlátozza); a portál a tiltás egyetlen eseményéhez
        # rendeli ezeket a találatokat, ezért a felület nem kap
        # csomagonkénti sort. A tiltás lejártával a kernel magától törli az
        # elemet.
        ip saddr @banned_v4 limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=fail2ban " group __DROP_LOG_GROUP__
        ip saddr @banned_v4 drop

        # MAC-kötés: aki engedélyezett IP-t használ, annak a munkamenet
        # alatt rögzített MAC-címmel kell küldenie. Ez a DHCP-lejárat
        # után más géphez kerülő IP és a LAN-on belüli IP-hamisítás
        # ellen véd. A MAC-t a portál az ARP-táblából rögzíti.
        iifname "__LAN_IF__" ip saddr @allowed_v4 ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr @allowed_v4 ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" meta l4proto tcp ct original ip saddr . ct original proto-dst @allowed_tcp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" meta l4proto tcp ct original ip saddr . ct original proto-dst @allowed_tcp ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" meta l4proto udp ct original ip saddr . ct original proto-dst @allowed_udp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" meta l4proto udp ct original ip saddr . ct original proto-dst @allowed_udp ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" ip saddr @allowed_icmp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr @allowed_icmp ip saddr . ether saddr != @client_mac drop

        # Admin által beállított blokk. Feltétel nélkül hívjuk: a block lánc
        # a conntrack eredeti tuple-jára illeszkedik, ezért a válaszirányt
        # is lefedi, és a LAN, a WAN/DNAT, valamint a Docker-híd felől
        # érkező csomagok is ide jutnak. Egy LAN-ra korlátozott ugrás esetén
        # a szerver oldala egy meglévő folyamban a tiltás után is küldhetne,
        # a WAN/DNAT-forgalom pedig sosem érné el a blokkláncot. A blokk
        # minden engedély (session, pre-auth, konténer) előtt fut, ezért az
        # aktív munkamenet sem kerülheti meg; conntrack-ürítésre nincs
        # szükség, mert minden csomag ide jut.
        jump block

        # Portra korlátozott hozzáférés. A ct original proto-dst a DNAT
        # ELŐTTI célportot jelenti, ezért a Docker által publikált
        # konténerportoknál a host portjával kell a szabályban szerepelni.
        # Ugyanez a pár a válaszirányban is illeszkedik (a conntrack
        # original tuple a kliensforgalomé), ezért külön válaszszabály nem
        # kell. Ha az elem lejár, a válaszok is elakadnak; a conntrack
        # törlése ezt azonnal érvényesíti a meglévő kapcsolatokra is.
        # A meta l4proto előtag kötelező: nélküle a ct original proto-dst
        # mérete nem ismert a concat kifejezésben (nft 1.0.6).
        #
        # Minden engedélyező szabály megjelöli a csomagot. A Docker
        # DOCKER-USER láncában csak ezt a jelölést engedjük át; így ha ez a
        # tábla bármiért eltűnne, a Docker saját FORWARD-szabályai (például
        # a publikált konténerportok) sem nyitnak utat, mert nincs jelölés.
        meta l4proto tcp ct original ip saddr . ct original proto-dst @allowed_tcp meta mark set __FWD_MARK__ accept
        meta l4proto udp ct original ip saddr . ct original proto-dst @allowed_udp meta mark set __FWD_MARK__ accept
        ip saddr @allowed_icmp ip protocol icmp meta mark set __FWD_MARK__ accept

        # Teljes hozzáférés.
        ip saddr @allowed_v4 meta mark set __FWD_MARK__ accept

        # A teljes hozzáférés és az ICMP válasziránya. A portos szabályok
        # válaszát a fenti ct original szabályok fedik le.
        ct state established,related ip daddr @allowed_icmp ip protocol icmp meta mark set __FWD_MARK__ accept
        ct state established,related ip daddr @allowed_v4 meta mark set __FWD_MARK__ accept

        # A WAN felől ne lehessen a konténer forrásával csomagot küldeni:
        # a konténer kimenő engedélyei csak a Docker-híd felől érvényesek.
        iifname "__WAN_IF__" ip saddr 172.30.0.2 limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=container-spoof " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" ip saddr 172.30.0.2 drop

        # A konténer ne indíthasson új kapcsolatot a belső LAN felé. A
        # kliens -> konténer kapcsolatok válaszai established állapotúak,
        # ezért azokat ez a szabály nem érinti.
        ip saddr 172.30.0.2 ip daddr __LAN_NET__ ct state new limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=container-pivot " group __DROP_LOG_GROUP__
        ip saddr 172.30.0.2 ip daddr __LAN_NET__ ct state new drop

        # A Minecraft konténer kimenő forgalma. A konténer saját, dedikált
        # Docker-hálózaton fut (172.30.0.0/24, statikus 172.30.0.2 cím),
        # és a Mojang letöltéshez/bejelentkezéshez DNS, HTTP és HTTPS
        # kell neki. A válaszok established/related állapotban jönnek.
        # Ez nem nyitja meg a kliensforgalmat: a LAN felől továbbra is
        # csak a portál-szabály által engedélyezett portok mennek át.
        ip saddr 172.30.0.2 udp dport 53 meta mark set __FWD_MARK__ accept
        ip saddr 172.30.0.2 tcp dport { 53, 80, 443 } meta mark set __FWD_MARK__ accept
        # Csak a konténer által INDÍTOTT kapcsolatok válaszai. A korábbi
        # szabály minden, a konténerhez tartozó established forgalmat
        # átengedett, így a kliens->konténer kapcsolat a portengedély
        # lejárta után is életben maradt (a conntrack törlése nélkül).
        ip daddr 172.30.0.2 ct state established,related ct original ip saddr 172.30.0.2 meta mark set __FWD_MARK__ accept

        # Bejelentkezés előtti engedélyek. A pre-auth lánc a válaszirányt
        # is lefedi, ezért feltétel nélkül hívjuk.
        jump preauth

        # A fennmaradó, nem engedélyezett forgalom naplózott eldobása.
        # A limit csak a naplózást korlátozza; a drop minden csomagra fut.
        iifname "__LAN_IF__" limit rate 60/minute burst 120 packets log prefix "dropjak-drop reason=no-grant " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=wan-drop " group __DROP_LOG_GROUP__
        drop
    }

    chain input {
        iif lo accept

        # Vészhelyzeti lánc a legelső helyen: a benne lévő ideiglenes
        # accept túléli a sablon újratöltését. Alapból üres.
        jump breakglass
        # A portál és az SSH IPv4-only; IPv6-on semmilyen bejövő forgalmat
        # nem fogadunk (a loopback kivételével).
        meta nfproto ipv6 limit rate 10/minute burst 20 packets log prefix "dropjak-drop reason=ipv6 " group __DROP_LOG_GROUP__
        meta nfproto ipv6 drop

        # DHCP-kérés a címkiosztás előtt 0.0.0.0 forrással érkezik, ezért
        # ezt a forrás-ellenőrzés előtt engedjük át. Csak a szabványos
        # kliensportról (68) a szerverportra (67), és csak 0.0.0.0 forrással.
        iifname "__LAN_IF__" ip saddr 0.0.0.0 udp sport 68 udp dport 67 accept

        # Forrás-IP hamisítás tiltása a host felé is. A WAN felől tilos a
        # LAN címét felvenni; a LAN felől csak a LAN hálózata jöhet.
        iifname "__LAN_IF__" ip saddr != __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-lan " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr != __LAN_NET__ drop
        iifname "__WAN_IF__" ip saddr __LAN_NET__ limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=spoof-wan " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" ip saddr __LAN_NET__ drop

        # fail2ban-tiltott forrás a host felé. A portál és a DHCP kivétel:
        # a tiltott kliens továbbra is elérheti a belépőoldalt (ott látja a
        # tiltás okát), és a DHCP-címe sem veszik el. Minden más host-
        # szolgáltatás (SSH, DNS, ICMP) és a forward-forgalom eldobódik,
        # akkor is, ha pre-auth szabály engedélyezné. A tiltás tényét a
        # portál egyetlen drop-log eseményként rögzíti; a tiltás alatti,
        # mintavételezve naplózott csomagokat ehhez az eseményhez rendeli.
        iifname "__LAN_IF__" udp sport 68 udp dport 67 accept
        iifname "__LAN_IF__" tcp dport __PORT__ accept
        ip saddr __PORTAL_NET__ tcp dport __PORT__ accept
        ip saddr @banned_v4 limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=fail2ban " group __DROP_LOG_GROUP__
        ip saddr @banned_v4 drop

        # Admin által beállított blokk a host felé irányuló forgalomra is.
        # Feltétel nélküli, ezért a host-engedélyek és a meglévő host-
        # kapcsolatok sem kerülhetik meg. A loopback, a breakglass, a DHCP
        # és a portál korábbi elfogadása érintetlen marad, így egy blokk-
        # bejegyzés nem zárhatja ki a portált vagy a vészhelyzeti
        # hozzáférést. A block lánc a conntrack eredeti tuple-jára
        # illeszkedik, ezért minden csomagra fut; conntrack-ürítésre nincs
        # szükség.
        jump block

        # A host felé irányuló engedélyezett forgalom (SSH, DNS, ICMP) is
        # csak a munkamenet alatt rögzített MAC-csel jöhet a LAN-on. A portál
        # forgalmát ez nem érinti, mert a portál IP-je nincs a dinamikus
        # halmazokban.
        iifname "__LAN_IF__" ip saddr @allowed_v4 ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr @allowed_v4 ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" ip saddr @allowed_icmp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr @allowed_icmp ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" udp dport 53 ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" udp dport 53 ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" tcp dport 53 ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" tcp dport 53 ip saddr . ether saddr != @client_mac drop
        # A host (input) szabályok portjai is csak a rögzített MAC-csel
        # érhetők el a LAN felől, ugyanúgy, mint a forward engedélyek.
        iifname "__LAN_IF__" ip saddr . tcp dport @allowed_input_tcp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr . tcp dport @allowed_input_tcp ip saddr . ether saddr != @client_mac drop
        iifname "__LAN_IF__" ip saddr . udp dport @allowed_input_udp ip saddr . ether saddr != @client_mac limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=mac " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" ip saddr . udp dport @allowed_input_udp ip saddr . ether saddr != @client_mac drop

        # Caddy aldomain-proxy (csak HV_PROXY=1 mellett; különben a belépési
        # pont kikommentálja). Szándékosan a fail2ban-drop, a blokk és a
        # MAC-ellenőrzés UTÁN: a tiltott forrás a proxyt sem érheti el. A
        # jogosultságot a Caddy kérésenként a portáltól kérdezi, ezért a
        # port nyilvános; a LAN felől (hairpin) csak rögzített IP+MAC
        # párral. A host-őrök elé kerül, hogy egy régi host szabály 80/443
        # őrbejegyzése ne vágja el a proxykapcsolatokat. A nem engedélyezett
        # LAN-kliens TCP 80-ját a prerouting továbbra is a portálra
        # irányítja; az engedélyezettét nem, ezért a LAN-on a 80 is kell.
        __PROXY__iifname "__WAN_IF__" tcp dport { 80, 443 } accept
        __PROXY__iifname "__LAN_IF__" tcp dport { 80, 443 } ip saddr . ether saddr @client_mac accept

        # A meglévő TCP DNS-kapcsolat se maradjon életben a jogosultság
        # lejárta után. (Az UDP DNS minden kérése külön csomag, ezért azt a
        # lenti engedélyező szabályok zárják le.) Az engedélyezett host
        # (input) TCP 53 szabályt kivesszük: a host kapcsolat valódi
        # jogosultságát a lenti host_service_* őr ellenőrzi, így a DNS-őr
        # nem szakítja meg a szabály élettartama alatt.
        iifname "__LAN_IF__" tcp dport 53 ct state established,related \
            ip saddr != @allowed_v4 ip saddr . tcp dport != @allowed_tcp \
            ip saddr . tcp dport != @allowed_input_tcp limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=dns-revoked " group __DROP_LOG_GROUP__
        iifname "__LAN_IF__" tcp dport 53 ct state established,related \
            ip saddr != @allowed_v4 ip saddr . tcp dport != @allowed_tcp \
            ip saddr . tcp dport != @allowed_input_tcp drop

        # Meglévő SSH-kapcsolat csak addig marad életben, amíg az
        # (IP, 22) pár szerepel az allowed_input_tcp halmazban, azaz a
        # felhasználóhoz rendelt, TCP 22-t engedélyező host szabály aktív.
        # Ha az engedély eltűnik (lejárat, kilépés, összeomlás után is), a
        # kapcsolat lezárul. Ez a szabály a lenti általános
        # established-accept elé kerül, különben a visszavont SSH túlélne.
        tcp dport 22 ct state established,related ip saddr . tcp dport != @allowed_input_tcp limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=ssh-revoked " group __DROP_LOG_GROUP__
        tcp dport 22 ct state established,related ip saddr . tcp dport != @allowed_input_tcp drop

        # A host DNS-szolgáltatása (53) a későbbi, LAN-os elfogadó
        # szabályokkal azonos feltételekkel már established állapotban is
        # elérhető a forward engedéllyel rendelkező kliensnek. Ez a szűk
        # kivétel csak a DNS/53-ra vonatkozik, ezért nem nyit utat a host
        # szolgáltatások felé. A DHCP (a cím megtartásához belépés előtt is
        # kell) ugyanígy a host-őr előtt megy át, hogy egy elavult
        # host_service_udp 67 bejegyzés ne szakítsa meg a megújítást.
        iifname "__LAN_IF__" tcp dport 53 ct state established,related ip saddr @allowed_v4 accept
        iifname "__LAN_IF__" tcp dport 53 ct state established,related ip saddr . tcp dport @allowed_tcp accept
        iifname "__LAN_IF__" udp dport 53 ct state established,related ip saddr @allowed_v4 accept
        iifname "__LAN_IF__" udp dport 53 ct state established,related ip saddr . udp dport @allowed_udp accept
        iifname "__LAN_IF__" udp sport 68 udp dport 67 accept

        # Meglévő host (input) kapcsolat se maradjon életben, ha az IP
        # kikerült az allowed_input_tcp/allowed_input_udp halmazból. Az
        # input lánc a host szolgáltatásokhoz csak a kliens→host irányú
        # csomagokat látja; a portál-átirányított csomagok célportja ekkor
        # már 8100, ezért a csomag szintű tcp/udp dport a helyes kulcs.
        # A DNS/53 és a DHCP saját elfogadó szabályai a fentiek; minden
        # más host-portra a host_service_* halmazok (csak hozzáadás)
        # zárják le a folyamot, ha az engedély eltűnik. Így a
        # conntrack-ürítés elmaradása és a nf_conntrack_tcp_loose által
        # újraélesztett folyam esetén is zár.
        # A TCP 22-es portot szándékosan kivesszük az általános őrből: a
        # TCP 22 kizárólag az SSH-specifikus őr hatásköre (fent), így nem
        # két helyen dől el ugyanaz a kapcsolat. Az UDP őr nem kap ilyen
        # kivételt: az SSH-őr TCP-only, a UDP 22 közönséges host-port.
        tcp dport @host_service_tcp tcp dport != 22 ct state established,related \
            ip saddr . tcp dport != @allowed_input_tcp \
            limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=host-revoked " group __DROP_LOG_GROUP__
        tcp dport @host_service_tcp tcp dport != 22 ct state established,related \
            ip saddr . tcp dport != @allowed_input_tcp drop
        udp dport @host_service_udp ct state established,related \
            ip saddr . udp dport != @allowed_input_udp \
            limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=host-revoked " group __DROP_LOG_GROUP__
        udp dport @host_service_udp ct state established,related \
            ip saddr . udp dport != @allowed_input_udp drop

        ct state established,related accept

        # ICMP a host felé csak engedélyezett kliensnek, és csak ping.
        # A kapcsolódó ICMP-hibák a fenti established,related szabályon
        # mennek át; a belépés előtti ping nem hozzáférési útvonal.
        iifname "__LAN_IF__" ip saddr @allowed_v4 icmp type echo-request accept
        iifname "__LAN_IF__" ip saddr @allowed_icmp icmp type echo-request accept

        # A belépőoldal mindenki számára elérhető. A LAN felől mindig; a
        # __PORTAL_NET__ a portál forrás-hálózata, 0.0.0.0/0 értékkel
        # nyilvánosan is.
        iifname "__LAN_IF__" tcp dport __PORT__ accept
        ip saddr __PORTAL_NET__ tcp dport __PORT__ accept

        # Host (input) szabály: a portálgép saját szolgáltatása a belépett
        # kliens IP-jének. Nincs iifname feltétel, ezért LAN-ról és WAN-ról
        # egyaránt működik; a fail2ban- és MAC-drop szabályok előbb futnak.
        # Ez az egyetlen SSH-elfogadási útvonal is: a TCP 22 csak akkor
        # nyílik meg, ha egy admin által létrehozott, a felhasználóhoz
        # rendelt host szabály kifejezetten tartalmazza, és a munkamenet
        # aktív. A portál a szabály és a TTL kiválasztása után teszi be az
        # IP-t; a jelszó önmagában nem. Kilépéskor azonnal, lejáratkor a
        # kernel-timeouttal törlődik. A 8100-as (portál) port továbbra is
        # fenntartott, és ezt a szabály is kizárja (védelem a kézzel
        # felvett elemek ellen). Vészhelyzeti közvetlen hozzáféréshez külön
        # breakglass szabály használható.
        ip saddr . tcp dport @allowed_input_tcp tcp dport != 8100 accept
        ip saddr . udp dport @allowed_input_udp udp dport != 8100 accept

        # A host DNS-szolgáltatása (dnsmasq) csak a kiválasztott szabály
        # alapján érhető el. Enélkül a portál előtt is nyitva lenne egy
        # DNS-alagút a hoston keresztül, ami megkerülné a forward-szabályokat.
        iifname "__LAN_IF__" ip saddr @allowed_v4 udp dport 53 accept
        iifname "__LAN_IF__" ip saddr . udp dport @allowed_udp udp dport 53 accept
        iifname "__LAN_IF__" ip saddr @allowed_v4 tcp dport 53 accept
        iifname "__LAN_IF__" ip saddr . tcp dport @allowed_tcp tcp dport 53 accept

        # A portálra nem engedélyezett bejövő forgalom naplózása. A lánc
        # policy drop; a limit csak a naplózást korlátozza.
        iifname "__LAN_IF__" limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=input-lan " group __DROP_LOG_GROUP__
        iifname "__WAN_IF__" limit rate 30/minute burst 60 packets log prefix "dropjak-drop reason=input-wan " group __DROP_LOG_GROUP__
    }

    chain prerouting {
        # A beállított blokkolt TCP 80-at már a portál-átirányítás előtt
        # eldobjuk; a pre-auth TCP 80 pedig conntrack-jelölést kap, hogy a
        # lenti redirect return-nel kikerülhető legyen.
        iifname "__LAN_IF__" jump block_nat
        iifname "__LAN_IF__" jump preauth_nat
        iifname "__LAN_IF__" ct mark 0x50524541 return

        # Aki még nincs engedélyezve, HTTP-n (80) a belépőoldalra kerül.
        # A teljes és a portokra korlátozott hozzáférés is megkerüli a
        # redirectet, különben a TCP 80 engedély ellenére is a portálra
        # terelődne a forgalom.
        iifname "__LAN_IF__" ip saddr @allowed_v4 return
        # A Docker DNAT-je ugyanebben a prerouting szakaszban futhat, ezért
        # itt is a DNAT előtti portot kell nézni, különben a publikált
        # konténerport forgalma tévesen a portálra terelődne. A meta
        # l4proto előtag itt is a concat típusához kell.
        iifname "__LAN_IF__" meta l4proto tcp ip saddr . ct original proto-dst @allowed_tcp return
        iifname "__LAN_IF__" meta l4proto udp ip saddr . ct original proto-dst @allowed_udp return
        # A host szabály által megnyitott TCP 80 (a portálgép saját
        # szolgáltatása) szintén megkerüli a portál-átirányítást; UDP-nél
        # nincs redirect.
        iifname "__LAN_IF__" meta l4proto tcp ip saddr . ct original proto-dst @allowed_input_tcp return
        iifname "__LAN_IF__" meta l4proto tcp ct original proto-dst 80 redirect to :__PORT__
    }

    chain postrouting {
        oifname "__WAN_IF__" ip saddr __LAN_NET__ masquerade
    }
}
